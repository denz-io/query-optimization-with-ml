# Connection string used by every script. Keep it out of the code you screen-share.
SMART_DSN=postgresql://postgres:demo@localhost:5432/smartdemo
PGPORT=5432
# Data scale. Baseline inference is a per-row UDF, so ~2-5M rows already gives a
# 20-60 s baseline on a laptop. Raise it if your machine is fast.
APARTMENT_ROWS=3000000
BUILDING_ROWS=300000
LANDLORD_ROWS=100000
DISTRICT_ROWS=1000
